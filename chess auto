local function fmtEval(score, side, mate)
  if mate then
    if mate > 0 then return "M" .. mate end
    return "M-" .. math.abs(mate)
  end
  local wp = side == Engine.WHITE and score or -score
  local v = wp / 100
  return (v >= 0 and "+" or "") .. string.format("%.2f", v)
end

local function buildSteps(a)
  local b = getBoard()
  if not b then return nil end
  local fsq = b.Squares:FindFirstChild(a.from)
  local tsq = b.Squares:FindFirstChild(a.to)
  if not fsq or not tsq then return nil end
  local fx, fy = centerOf(fsq)
  local tx, ty = centerOf(tsq)
  if a.mode == "drag" then
    return {
      {0.00, function() moveMouse(fx, fy) end},
      {0.06, function() mouseDown(fx, fy) end},
      {0.12, function() moveMouse(fx + (tx - fx) * 0.33, fy + (ty - fy) * 0.33) end},
      {0.18, function() moveMouse(fx + (tx - fx) * 0.66, fy + (ty - fy) * 0.66) end},
      {0.24, function() moveMouse(tx, ty) end},
      {0.30, function() mouseUp(tx, ty) end},
    }
  end
  return {
    {0.00, function() moveMouse(fx, fy) end},
    {0.05, function() mouseDown(fx, fy) end},
    {0.10, function() mouseUp(fx, fy) end},
    {0.22, function() moveMouse(tx, ty) end},
    {0.27, function() mouseDown(tx, ty) end},
    {0.32, function() mouseUp(tx, ty) end},
  }
end

local function startPlay(uci, fen, mode)
  if act then return end
  local a = {
    uci = uci, from = string.sub(uci, 1, 2), to = string.sub(uci, 3, 4),
    mode = mode or st.mode, fenBefore = fen, t0 = os.clock(), i = 1,
  }
  a.steps = buildSteps(a)
  if not a.steps then
    setSub("board not ready")
    return
  end
  act = a
  st.awaitFen = fen
  setSub("playing " .. uci)
  describe()
end

local function tickAct(now)
  if not act then return end
  local a = act
  while a.i <= #a.steps and (now - a.t0) >= a.steps[a.i][1] do
    local okf, err = pcall(a.steps[a.i][2])
    if not okf then warn("[Chess] input error: " .. tostring(err)) end
    a.i = a.i + 1
  end
  if a.i <= #a.steps then return end
  if now - a.t0 < 0.85 then return end

  local b = getBoard()
  local prom = b and b.Promotion
  if prom and prom.Visible then
    if a.promStage == nil then
      local q = prom.Face:FindFirstChild("Q")
      if q then
        local qx, qy = centerOf(q)
        moveMouse(qx, qy)
        mouseDown(qx, qy)
        a.promStage = 1
        a.promAt = now + 0.06
        return
      end
    elseif a.promStage == 1 and now >= (a.promAt or 0) then
      local q = prom.Face:FindFirstChild("Q")
      if q then
        local qx, qy = centerOf(q)
        mouseUp(qx, qy)
      end
      a.promStage = 2
      a.t0 = now - 0.5
      return
    end
    if a.promStage ~= 2 then return end
  end

  local fenNow = readFen()
  if fenNow and fenNow ~= a.fenBefore then
    st.awaitFen = nil
    setSub("played " .. a.uci)
    act = nil
    describe()
    return
  end

  if a.mode ~= "drag" and not a.retried then
    a.retried = true
    a.mode = "drag"
    a.steps = buildSteps(a)
    a.i = 1
    a.t0 = now
    setSub("retrying with drag")
    return
  end

  act = nil
  st.awaitFen = nil
  st.failUntil = now + 3
  setSub("click failed - try again")
  describe()
end

local function solve()
  if st.thinking then return end
  local pos = readPos()
  if not pos or pos.side ~= st.color then return end
  local fen = readFen()
  if not fen then return end
  if Search.isBusy() then return end
  st.thinking = true
  describe()
  local clone = Engine.clone(pos)
  local ok, res = pcall(function()
    return solver:think(clone, { maxDepth = CFG.depth, maxTime = CFG.maxTime })
  end)
  st.thinking = false
  if not ok then
    pcall(function() debug.setupvalue(Search.isBusy, 1, false) end)
    setSub("search busy, retrying")
    describe()
    return false
  end
  if not res or not res.move or res.move == 0 then
    setSub("no move")
    describe()
    return false
  end
  st.uci = Engine.uci(res.move)
  st.san = tostring(Engine.san(clone, res.move))
  st.score = res.score or 0
  st.depth = res.depth or 0
  st.nodes = res.nodes or 0
  st.mate = res.mate
  describe()
  setSub(string.format("%s  d%d  %s", fmtEval(st.score, clone.side, st.mate), st.depth, st.nodes >= 1000 and string.format("%dk", math.floor(st.nodes / 1000)) or tostring(st.nodes)))
  pcall(function()
    turnLbl.Text = (st.color == Engine.WHITE and "WHITE" or "BLACK") .. "  -  YOUR TURN"
    turnLbl.TextColor3 = Color3.fromRGB(90, 220, 140)
    playBtn.BackgroundColor3 = ACCENT
    playBtn.Text = "PLAY MOVE"
  end)
  pcall(B.clearArrows)
  pcall(B.arrow, string.sub(st.uci, 1, 2), string.sub(st.uci, 3, 4), nil, 0.6)
  return true
end

