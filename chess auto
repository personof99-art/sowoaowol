local function readPos()
  local ok, p = pcall(B.position)
  if ok and type(p) == "table" then return p end
  return nil
end

local function readFen()
  local p = readPos()
  if not p then return nil end
  local ok, f = pcall(Engine.toFen, p)
  if ok and type(f) == "string" then return f end
  return nil
end

local function getBoard()
  local pg = lp:FindFirstChildOfClass("PlayerGui")
  if not pg then return nil end
  local g = pg:FindFirstChild("GameUI")
  if not g then return nil end
  local ok, b = pcall(function() return g.Root.Body.Center.BoardHolder.Face.Board end)
  if ok then return b end
  return nil
end

local function centerOf(o)
  return o.AbsolutePosition.X + o.AbsoluteSize.X * 0.5, o.AbsolutePosition.Y + o.AbsoluteSize.Y * 0.5
end

local function moveMouse(x, y) VIM:SendMouseMoveEvent(x, y + inset.Y, game) end
local function mouseDown(x, y) VIM:SendMouseButtonEvent(x, y + inset.Y, 0, true, game, 0) end
local function mouseUp(x, y) VIM:SendMouseButtonEvent(x, y + inset.Y, 0, false, game, 0) end

local function findMySide()
  local okGC, GC = pcall(require, ps.Controllers.GameController)
  if okGC and type(GC) == "table" then
    for _, f in pairs(GC) do
      if type(f) == "function" then
        for i = 1, 60 do
          local oku, v = pcall(debug.getupvalue, f, i)
          if not oku then break end
          if type(v) == "table" and rawget(v, "you") ~= nil and rawget(v, "startFen") ~= nil then
            return v.you, v
          end
        end
      end
    end
  end
  local oko, o = pcall(B.orientation)
  if oko and (o == 0 or o == 8) then return o, nil end
  return nil, nil
end

local gd, gdAt = nil, 0
local function getGameData()
  local now = os.clock()
  if gd and now - gdAt < 2 then return gd end
  local _, found = findMySide()
  gd, gdAt = found, now
  return gd
end

local function inLiveGame()
  local g = getGameData()
  if not g then return false end
  if g.watch then return false end
  if g.you == nil then return false end
  return true
end

