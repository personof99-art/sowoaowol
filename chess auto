playBtn.MouseButton1Click:Connect(function()
  if act then setSub("already playing") return end
  local pos = readPos()
  if not pos or pos.side ~= st.color then setSub("not your turn") return end
  if not inLiveGame() then setSub("not in a game") return end
  local fen = readFen()
  if not fen then return end
  if not st.uci then
    if not solve() then return end
  end
  startPlay(st.uci, fen, st.mode)
end)

table.insert(conns, UIS.InputBegan:Connect(function(input, gp)
  if gp then return end
  if input.KeyCode == CFG.key then
    st.enabled = not st.enabled
    if not st.enabled then
      pcall(B.clearArrows)
      act = nil
      st.pending = nil
    end
    describe()
  end
end))

local lastPoll = 0
table.insert(conns, RunService.Heartbeat:Connect(function()
  local now = os.clock()
  tickAct(now)
  if now - lastPoll < 0.25 then return end
  lastPoll = now
  if not st.enabled then return end
  if act then return end

  local fen = readFen()
  if not fen then setSub("no board") return end
  if fen ~= st.lastFen then
    st.lastFen = fen
    st.san, st.uci, st.pending = nil, nil, nil
    describe()
    local pos = readPos()
    st.side = pos and pos.side or nil
    local mine = st.side == st.color
    if not mine then
      pcall(B.clearArrows)
      setSub(st.auto and "waiting for opponent..." or "not your move")
      pcall(function()
        turnLbl.Text = (st.side == Engine.WHITE and "WHITE" or "BLACK") .. " to move  -  waiting"
        turnLbl.TextColor3 = GREY
        playBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
        playBtn.Text = "NOT YOUR TURN"
      end)
    elseif not inLiveGame() then
      pcall(B.clearArrows)
      setSub("not in a game")
      pcall(function()
        turnLbl.Text = "no active game"
        turnLbl.TextColor3 = GREY
        playBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
        playBtn.Text = "NOT IN GAME"
      end)
    else
      if solve() and st.auto and st.uci and now >= st.failUntil then
        st.pending = { uci = st.uci, fen = fen, at = now + CFG.playDelay }
      end
    end
  end

  if st.pending and now >= st.pending.at then
    local p = st.pending
    st.pending = nil
    if readFen() == p.fen then
      startPlay(p.uci, p.fen, st.mode)
    end
  end
end))

function st.unload()
  for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
  conns = {}
  act = nil
  pcall(B.clearArrows)
  if gui then gui:Destroy() gui = nil end
  if getgenv().ChessEngine == st then getgenv().ChessEngine = nil end
  print("[Chess] unloaded")
end

