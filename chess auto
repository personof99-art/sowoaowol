local function describe()
  pcall(function()
    if not st.enabled then
      moveLbl.Text = "OFF"
      moveLbl.TextColor3 = Color3.fromRGB(120, 120, 130)
      tag.Text = "OFF"
      tag.TextColor3 = GREY
      turnLbl.Text = ""
      return
    end
    tag.Text = act and "PLAYING" or (st.thinking and "THINK" or (st.auto and "AUTO" or "ON"))
    tag.TextColor3 = (act or st.thinking) and YELLOW or (st.auto and YELLOW or GREEN)
    if st.san then
      moveLbl.Text = st.san
      moveLbl.TextColor3 = Color3.fromRGB(240, 240, 245)
    elseif st.thinking then
      moveLbl.Text = "..."
      moveLbl.TextColor3 = Color3.fromRGB(200, 200, 210)
    else
      moveLbl.Text = "--"
      moveLbl.TextColor3 = Color3.fromRGB(140, 140, 150)
    end
    whiteBtn.BackgroundColor3 = st.color == Engine.WHITE and ACCENT or IDLE
    blackBtn.BackgroundColor3 = st.color == Engine.BLACK and ACCENT or IDLE
    whiteBtn.TextColor3 = st.color == Engine.WHITE and Color3.fromRGB(255, 255, 255) or GREY
    blackBtn.TextColor3 = st.color == Engine.BLACK and Color3.fromRGB(255, 255, 255) or GREY
    autoBtn.BackgroundColor3 = st.auto and Color3.fromRGB(150, 110, 40) or IDLE
    autoBtn.Text = st.auto and "AUTO-PLAY: ON" or "AUTO-PLAY: OFF"
    autoBtn.TextColor3 = st.auto and Color3.fromRGB(255, 235, 180) or GREY
  end)
end

