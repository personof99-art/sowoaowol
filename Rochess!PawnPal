--=============================================================
-- helpers
--=============================================================
local function make(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    for _, c in ipairs(children or {}) do c.Parent = inst end
    return inst
end

local function round(inst, px)
    make("UICorner", { CornerRadius = UDim.new(0, px) }).Parent = inst
    return inst
end

local function stroke(inst, color, px, transparency)
    make("UIStroke", {
        Color = color or STROKE,
        Thickness = px or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }).Parent = inst
    return inst
end

local function fmtEval(res)
    if not res then return "" end
    if res.mate then
        local n = math.abs(res.mate)
        return (res.mate > 0 and "M" or "-M") .. tostring(n)
    end
    local s = (res.score or 0) / 100
    return string.format("%+.2f", s)
end

local function moveSan(session, uci)
    local ok, san = pcall(function()
        local fen, ucis = session:searchArgs()
        local e = Engine.new(fen or Engine.START_FEN)
        for _, u in ipairs(ucis) do e:playUci(u) end
        local m = e:moveFromUci(uci)
        return m and e:moveToSan(m) or uci
    end)
    return ok and san or uci
end

local function timing()
    local p = bullet and SPEED.bullet or SPEED.normal
    if not bullet then return p end

    -- burn a slice of the real clock when the game exposes one,
    -- so a 30s bullet game gets faster replies than a 2min one
    local t = p.thinkTime
    local session = App.session
    if session and session.clocks and type(session.clockFor) == "function" then
        local ok, ms = pcall(session.clockFor, session, ourColor(session))
        if ok and type(ms) == "number" and ms > 0 then
            t = math.clamp(ms / 25000, 0.06, p.thinkTime)
        end
    end
    return {
        thinkTime  = t,
        maxDepth   = p.maxDepth,
        replyTime  = math.max(0.04, t * (p.replyTime / p.thinkTime)),
        replyDepth = p.replyDepth,
        autoDelay  = p.autoDelay,
        clickDelay = p.clickDelay,
        poll       = p.poll,
        confirm    = p.confirm,
    }
end

local function analyse(fen, ucis, t)
    local ok, res = pcall(Bot.analyse, fen, table.clone(ucis), t.thinkTime, t.maxDepth)
    if ok and type(res) == "table" then return res end
    return nil
end

local function stillValid(session, ply)
    return session ~= nil
        and App.session == session
        and not session.over
        and isOurTurn(session)
        and session.viewPly == #session.ucis
        and #session.ucis == ply
end

local function clearHint()
    pcall(function()
        if App.board and App.board.setArrow then App.board:setArrow("hint", nil) end
    end)
end

local function clearArrow()
    pcall(function()
        if App.board and App.board.setArrow then
            App.board:setArrow("hint", nil)
            App.board:setArrow("plan", nil)
        end
    end)
end

local function showArrow(uci)
    pcall(function()
        local from = Engine.algToIndex64(uci:sub(1, 2))
        local to = Engine.algToIndex64(uci:sub(3, 4))
        if App.board and App.board.setArrow then
            App.board:setArrow("hint", from, to, CONFIG.hintColor, 0.16)
        end
    end)
end

-- think ahead for YOU: play the best move, assume their likely answer,
-- then draw the follow-up you are planning (transparent red)
local function planReply(fen, ucis, uci, t)
    pcall(function()
        local startFen = fen or Engine.START_FEN

        local afterUs = table.clone(ucis)
        table.insert(afterUs, uci)

        local theirs = Bot.analyse(startFen, afterUs, t.replyTime, t.replyDepth)
        if not theirs or not theirs.best then return end

        local afterThem = table.clone(afterUs)
        table.insert(afterThem, theirs.best)

        local ours = Bot.analyse(startFen, afterThem, t.replyTime, t.replyDepth)
        if not ours or not ours.best then return end

        -- only while the board is still at (or one ply past) our move
        local now = App.session and #App.session.ucis
        if now ~= #ucis and now ~= #afterUs then return end

        local from = Engine.algToIndex64(ours.best:sub(1, 2))
        local to = Engine.algToIndex64(ours.best:sub(3, 4))
        if App.board and App.board.setArrow then
            App.board:setArrow("plan", from, to, CONFIG.replyColor, CONFIG.replyAlpha)
        end
    end)
end

-- real mouse clicks on the board (no remotes) -----------------
local VIM = game:GetService("VirtualInputManager")

local function screenCenter(gui)
    local p = gui.AbsolutePosition + gui.AbsoluteSize * 0.5
    return p.X, p.Y
end

local function clickAt(x, y)
    x, y = math.floor(x), math.floor(y)
    local ok = pcall(function()
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.03)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    if not ok then
        mousemoveabs(x, y)
        task.wait(0.02)
        mouse1click()
    end
end

local function clickSquare(index)
    local bv = App.board
    local sq = bv and bv.squares and bv.squares[index]
    if not sq or not sq.Visible then return false end
    local x, y = screenCenter(sq)
    clickAt(x, y)
    return true
end

local function clickMove(uci, t)
    local bv = App.board
    if not bv then return false end

    local session = App.session
    if not session then return false end

    -- a leftover manual selection would eat the first click
    if bv.selected then pcall(function() bv:deselect() end) end

    local startPly = #session.ucis
    local from = Engine.algToIndex64(uci:sub(1, 2))
    local to   = Engine.algToIndex64(uci:sub(3, 4))
    local promoNum = PROMO[uci:sub(5, 5)]

    local function currentPly()
        return App.session and #App.session.ucis or -1
    end

    local function waitForMove(seconds)
        local deadline = os.clock() + seconds
        repeat
            if currentPly() ~= startPly then return true end
            task.wait(0.01)
        until os.clock() >= deadline
        return false
    end

    -- click a square and wait until the board actually shows it selected
    local function pickSquare(index)
        for _ = 1, 3 do
            if not clickSquare(index) then return false end
            local deadline = os.clock() + 0.2
            repeat
                if bv.selected == index then return true end
                task.wait(0.01)
            until os.clock() >= deadline
        end
        return false
    end

    if not pickSquare(from) then
        -- the piece never stuck; one blind attempt anyway
        clickSquare(to)
        return waitForMove(t.confirm)
    end

    -- destination click can bounce off a board that is still settling
    for _ = 1, 3 do
        clickSquare(to)
        if waitForMove(promoNum and 0.2 or 0.18) then break end
        if bv.selected ~= from then break end
    end

    if promoNum then
        local choice
        for _ = 1, 40 do
            choice = bv.overlayLayer and bv.overlayLayer:FindFirstChild("Choice" .. promoNum, true)
            if choice then break end
            task.wait(0.02)
        end
        if choice then
            local x, y = screenCenter(choice)
            clickAt(x, y)
        end
        return waitForMove(t.confirm)
    end

    return currentPly() ~= startPly
end

