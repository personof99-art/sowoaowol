local petalConn
local petalClock = 0
local function animatePetals(dt)
    petalClock = petalClock + dt
    -- follow the card, including while it is dragged or collapsed
    petalLayer.Position = UDim2.new(0, card.AbsolutePosition.X, 0, card.AbsolutePosition.Y)
    petalLayer.Size = UDim2.fromOffset(card.AbsoluteSize.X, card.AbsoluteSize.Y)
    local w, h = petalLayer.AbsoluteSize.X, petalLayer.AbsoluteSize.Y
    if w <= 0 or h <= 0 then return end
    for _, q in ipairs(petals) do
        q.y = q.y + q.speed * dt
        if q.y > h + 12 then
            q.y = -12
            q.baseX = math.random()
        end
        local x = math.clamp(q.baseX * w + math.sin(petalClock * q.sway + q.phase) * q.swayAmt, 0, w)
        q.obj.Position = UDim2.new(0, math.floor(x), 0, math.floor(q.y))
        q.obj.Rotation = q.obj.Rotation + q.spin * dt
    end
end
petalConn = RunService.RenderStepped:Connect(animatePetals)

