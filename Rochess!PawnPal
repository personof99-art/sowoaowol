local mode = _G.__pawnpalMode or "hint" -- "hint" | "auto"
_G.__pawnpalMode = mode

local function refreshSwitch()
    local active, inactive
    if mode == "auto" then active, inactive = autoBtn, hintBtn else active, inactive = hintBtn, autoBtn end
    TweenSvc:Create(modePill, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
        Position = active.Position,
        BackgroundColor3 = mode == "auto" and PINK or MINT,
    }):Play()
    TweenSvc:Create(active, TweenInfo.new(0.18), { TextColor3 = ON_PILL }):Play()
    TweenSvc:Create(inactive, TweenInfo.new(0.18), { TextColor3 = MUTED }):Play()
end

local function setMode(m)
    mode = m == "auto" and "auto" or "hint"
    _G.__pawnpalMode = mode
    refreshSwitch()
end

hintBtn.MouseButton1Click:Connect(function() setMode("hint"); clearArrow() end)
autoBtn.MouseButton1Click:Connect(function() setMode("auto") end)
refreshSwitch()

