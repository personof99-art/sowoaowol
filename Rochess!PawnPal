    _G.__pawnpalBullet = bullet
    refreshSpeed()
    thinkToken = thinkToken + 1 -- drop any in-flight search
    lastKey = nil               -- re-evaluate with the new timing
end

local function refreshPlan()
    local active, inactive
    if plan then active, inactive = aheadBtn, plainBtn else active, inactive = plainBtn, aheadBtn end
    TweenSvc:Create(planPill, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
        Position = active.Position,
        BackgroundColor3 = plan and RED or MINT,
    }):Play()
    TweenSvc:Create(active, TweenInfo.new(0.18), { TextColor3 = ON_PILL }):Play()
    TweenSvc:Create(inactive, TweenInfo.new(0.18), { TextColor3 = MUTED }):Play()
end

local function setPlan(on)
    plan = on and true or false
    _G.__pawnpalPlan = plan
    refreshPlan()
    if not plan then
        pcall(function()
            if App.board and App.board.setArrow then App.board:setArrow("plan", nil) end
        end)
    elseif lastPlan and App.session == lastPlan.session
           and #App.session.ucis == lastPlan.ply and isOurTurn(App.session) then
        -- already analysed this position: show the red arrow right away
        planReply(lastPlan.fen, lastPlan.ucis, lastPlan.best, timing())
    end
end

local shownSide = nil
local function refreshSide()
    local mine = ourColor(App.session)
    if mine == shownSide then return end
    shownSide = mine
    local active, inactive, pill, ink
    if mine == 1 then
