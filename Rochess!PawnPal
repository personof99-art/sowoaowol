    TweenSvc:Create(inactive, TweenInfo.new(0.18), { TextColor3 = MUTED }):Play()
end

local function setMode(m)
    mode = m == "auto" and "auto" or "hint"
    _G.__pawnpalMode = mode
    refreshSwitch()
    lastKey = nil -- re-evaluate so switching to auto acts on the current position
end

local function refreshSpeed()
