--=============================================================
-- main loop
--=============================================================
local function scheduleThink(session, key)
    local ply = #session.ucis
    thinkToken = thinkToken + 1
    local token = thinkToken
    local t = timing()
    local fen, ucis = session:searchArgs()
    setThinking(true)
    setStatus((bullet and "⚡ " or "") .. (mode == "auto" and "thinking…" or "finding a move…"),
        mode == "auto" and PINK_DEEP or MINT_DEEP)
    chipLabel.Text = '<font color="#b07e96">best</font>  …'

    task.spawn(function()
        local res = analyse(fen, ucis, t)

        if token ~= thinkToken or not running then return end
        if not res or not res.best then
            setThinking(false)
            setStatus("no move found", RED)
            return
        end

        local san = moveSan(session, res.best)
        local ev = fmtEval(res)

        if not stillValid(session, ply) then
            -- position moved on while we were thinking
            setThinking(false)
            return
        end

        setThinking(false)
        showChip(san, ev)
        showArrow(res.best)
        setStatus("your move", MINT_DEEP)

        if mode == "auto" and lastAutoPly ~= ply then
            if t.autoDelay > 0 then task.wait(t.autoDelay) end
            if token ~= thinkToken or not running then return end
            if stillValid(session, ply) and lastAutoPly ~= ply then
                lastAutoPly = ply
                clickMove(res.best, t)
            end
        end

        -- remember this analysis for the red think-ahead arrow (our follow-up)
        lastPlan = { session = session, fen = fen, ucis = ucis, best = res.best, ply = ply }
        if plan then planReply(fen, ucis, res.best, t) end
    end)
end

local loopSession = nil
local function loop()
    while running do
        local session = App.session

        -- new game: forget any manual side choice and follow the game again
        if session ~= loopSession then
            loopSession = session
            sideChoice, sideSession = nil, nil
            lastPlan = nil
            refreshSide()
        end
        refreshSide() -- pill follows session.myColor until a manual choice is made

        if session and CONFIG.kinds[session.kind] then
            if session.over then
                clearArrow()
                setThinking(false)
                local st = session:status()
                setStatus(st == "checkmate" and "checkmate — gg" or "game over", MUTED)
                chipLabel.Text = '<font color="#b07e96">best</font>  –'
                lastKey = nil
                lastAutoPly = nil
            elseif session.viewPly ~= #session.ucis then
                clearArrow()
                setThinking(false)
                setStatus("reviewing…", MUTED)
                lastKey = nil
            elseif isOurTurn(session) then
                local key = session.kind .. ":" .. tostring(session.id) .. ":" .. #session.ucis
                if key ~= lastKey then
                    lastKey = key
                    scheduleThink(session, key)
                end
            else
                clearHint()
                setThinking(false)
                lastKey = nil
                -- keep the red plan visible while they think, unless we played something else
                if lastPlan and lastPlan.session == session then
                    local uc = session.ucis
                    if #uc ~= lastPlan.ply + 1 or uc[#uc] ~= lastPlan.best then
                        pcall(function() App.board:setArrow("plan", nil) end)
                    end
                end
                setStatus(session:status() == "check" and "you're in check" or "waiting for opponent", MUTED)
                chipLabel.Text = '<font color="#b07e96">best</font>  –'
            end
        else
            clearArrow()
            setThinking(false)
            setStatus("looking for a game…", MUTED)
            lastKey = nil
        end

        task.wait(bullet and SPEED.bullet.poll or SPEED.normal.poll)
    end
end

task.spawn(loop)

