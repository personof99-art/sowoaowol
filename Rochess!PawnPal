--=============================================================
-- side detection (white = 1, black = -1)
--=============================================================
local function ourColor(session)
    session = session or App.session
    if sideChoice and (sideSession == nil or sideSession == session) then
        return sideChoice == "white" and 1 or -1
    end
    return (session and session.myColor) or 1
end

local function isOurTurn(session)
    if not session or session.over then return false end
    local moving = session:sideToMove()
    return moving ~= nil and moving == ourColor(session)
end

