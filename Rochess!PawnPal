local pulseConn
local function setThinking(on)
    if pulseConn then pulseConn:Disconnect(); pulseConn = nil end
    dot.BackgroundTransparency = 0
    if on then
        local t = 0
        pulseConn = RunService.RenderStepped:Connect(function(dt)
            t = t + dt
            dot.BackgroundTransparency = 0.3 + 0.3 * math.sin(t * 6)
        end)
    end
end

local function setStatus(text, color)
    statusLabel.Text = text
    dot.BackgroundColor3 = color or MUTED
end

local function showChip(san, ev)
    chipLabel.Text = string.format('<font color="#9e938d">best</font>  <b>%s</b>  <font color="#5ed9a6">%s</font>', san, ev)
end

--=============================================================
-- main loop
--=============================================================
local running = true
local thinkToken = 0
local lastKey = nil
local lastAutoPly = nil

local function scheduleThink(session, key)
    local ply = #session.ucis
    thinkToken = thinkToken + 1
    local token = thinkToken
    setThinking(true)
    setStatus(mode == "auto" and "thinking…" or "finding a move…", mode == "auto" and PINK_DEEP or MINT_DEEP)
    chipLabel.Text = '<font color="#9e938d">best</font>  …'

    task.spawn(function()
        local res = analyse(session)

        if token ~= thinkToken or not running then return end
        if not res or not res.best then
            setThinking(false)
            setStatus("no move found", RED)
            return
        end

        local san = moveSan(session, res.best)
        local ev = fmtEval(res)

        if not stillValid(session, ply) then
            -- position moved on while we were thinking
            setThinking(false)
            return
        end

        setThinking(false)
        showChip(san, ev)
        showArrow(res.best)
        setStatus("your move", MINT_DEEP)

        if mode == "auto" and lastAutoPly ~= ply then
            task.wait(CONFIG.autoDelay)
            if token ~= thinkToken or not running then return end
            if stillValid(session, ply) and lastAutoPly ~= ply then
                lastAutoPly = ply
                clickMove(res.best)
            end
        end
    end)
end

local function loop()
    while running do
        local session = App.session

        if session and CONFIG.kinds[session.kind] then
            if session.over then
                clearArrow()
                setThinking(false)
                local st = session:status()
                setStatus(st == "checkmate" and "checkmate — gg" or "game over", MUTED)
                chipLabel.Text = '<font color="#9e938d">best</font>  –'
                lastKey = nil
                lastAutoPly = nil
            elseif session.viewPly ~= #session.ucis then
                clearArrow()
                setThinking(false)
                setStatus("reviewing…", MUTED)
                lastKey = nil
            elseif session:isMyTurn() then
                local key = session.kind .. ":" .. tostring(session.id) .. ":" .. #session.ucis
                if key ~= lastKey then
                    lastKey = key
                    scheduleThink(session, key)
                end
            else
                clearArrow()
                setThinking(false)
                lastKey = nil
                setStatus(session:status() == "check" and "you're in check" or "waiting for opponent", MUTED)
                chipLabel.Text = '<font color="#9e938d">best</font>  –'
            end
        else
            clearArrow()
            setThinking(false)
            setStatus("looking for a game…", MUTED)
            lastKey = nil
        end

        task.wait(0.2)
    end
end

task.spawn(loop)

