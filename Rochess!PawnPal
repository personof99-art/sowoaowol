    if bullet then active, inactive = bulletBtn, normalBtn else active, inactive = normalBtn, bulletBtn end
    TweenSvc:Create(speedPill, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
        Position = active.Position,
        BackgroundColor3 = bullet and AMBER or MINT,
    }):Play()
    TweenSvc:Create(active, TweenInfo.new(0.18), { TextColor3 = ON_PILL }):Play()
    TweenSvc:Create(inactive, TweenInfo.new(0.18), { TextColor3 = MUTED }):Play()
end

local function setBullet(on)
