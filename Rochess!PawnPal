-- speed presets. bullet moves as fast as the board allows.
local SPEED = {
    normal = {
        thinkTime  = 1.8,   -- seconds per search (higher = stronger, but freezes the client while thinking)
        maxDepth   = 30,    -- depth cap (time is the real limit)
        replyTime  = 0.6,   -- search for the opponent's likely reply (red arrow)
        replyDepth = 12,
        autoDelay  = 0.35,  -- pause before auto-playing so it looks natural
        clickDelay = 0.09,  -- gap between the two clicks on the board
        poll       = 0.20,  -- main loop tick
        confirm    = 0.80,  -- how long to wait for a click to register
    },
    bullet = {
        thinkTime  = 0.22,  -- short search; the client only freezes for a blink
        maxDepth   = 8,
        replyTime  = 0.08,
        replyDepth = 6,
        autoDelay  = 0.0,
        clickDelay = 0.02,
        poll       = 0.04,
        confirm    = 0.35,
