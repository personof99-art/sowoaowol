    thinkTime  = 1.8,                        -- seconds per search (higher = stronger, but freezes the client while thinking)
    maxDepth   = 30,                         -- depth cap (time is the real limit)
    autoDelay  = 0.35,                       -- pause before auto-playing so it looks natural
    clickDelay = 0.09,                       -- gap between the two clicks on the board
    hintColor  = Color3.fromRGB(124, 224, 180),
    hideKey    = Enum.KeyCode.RightShift,
    kinds      = { bot = true, online = true },
}

local PROMO = { q = 5, r = 4, b = 3, n = 2 }

