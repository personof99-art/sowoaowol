--=============================================================
-- Drawing helpers
--=============================================================

local function newDrawing(class, props)
    local d = Drawing.new(class)
    for k, v in pairs(props) do d[k] = v end
    return d
end

local function partsOf(model, entry)
    local parts = entry.parts
    local now = os.clock()
    if now - entry.partsAt > 0.75 or #parts == 0 then
        entry.partsAt = now
        local list = {}
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") and d.Transparency < 0.97 then
                list[#list + 1] = d
            end
        end
        entry.parts = list
        return list
    end
    return parts
end

local function worldBounds(parts)
    local minx, miny, minz = math.huge, math.huge, math.huge
    local maxx, maxy, maxz = -math.huge, -math.huge, -math.huge
    for _, p in ipairs(parts) do
        local cf, sz = p.CFrame, p.Size
        local hx, hy, hz = sz.X * 0.5, sz.Y * 0.5, sz.Z * 0.5
        for ix = -1, 1, 2 do
            for iy = -1, 1, 2 do
                for iz = -1, 1, 2 do
                    local w = cf * Vector3.new(hx * ix, hy * iy, hz * iz)
                    if w.X < minx then minx = w.X end
                    if w.Y < miny then miny = w.Y end
                    if w.Z < minz then minz = w.Z end
                    if w.X > maxx then maxx = w.X end
                    if w.Y > maxy then maxy = w.Y end
                    if w.Z > maxz then maxz = w.Z end
                end
            end
        end
    end
    return Vector3.new(minx, miny, minz), Vector3.new(maxx, maxy, maxz)
end

local function ageOf(inst)
    if not Hub.Config.ESP.ShowAge then return nil end
    local stage = inst and inst:GetAttribute("AgeStage")
    if stage and stage ~= "" then return stage end
    return nil
end

local function playerLabel(plr)
    local char = plr.Character
    local species = (char and char:GetAttribute("Species")) or "?"
    local name = char and char:GetAttribute("FeralName")
    if not name or name == "" then
        name = plr.DisplayName ~= "" and plr.DisplayName or plr.Name
    end
    local bits = { name, species }
    local age = ageOf(char)
    if age then bits[#bits + 1] = age end
    return table.concat(bits, " · ")
end

local function npcLabel(model)
    local species = model:GetAttribute("Species")
    if not species or species == "" then
        species = (model.Name:gsub("_%a+$", ""))
    end
    local age = ageOf(model)
    if age then return species .. " · " .. age end
    return species
end

--=============================================================
-- Cham pool
--=============================================================

local function takeCham()
    local h = table.remove(chamPool)
    if not h then
        h = Instance.new("Highlight")
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Name = "FeralCham"
    end
    return h
end

local function releaseCham(model)
    local h = assigned[model]
    if not h then return end
    assigned[model] = nil
    h.Adornee = nil
    h.Parent = nil
    chamPool[#chamPool + 1] = h
end

local function releaseAllChams()
    for model in pairs(assigned) do releaseCham(model) end
end

local function applyCham(model, color)
    local cfg = Hub.Config.ESP
    local h = assigned[model]
    if not h then
        h = takeCham()
        assigned[model] = h
        h.Parent = model
    end
    h.Adornee = model
    h.FillColor = color
    h.FillTransparency = cfg.FillTransparency
    h.OutlineColor = color
    h.OutlineTransparency = cfg.OutlineTransparency
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Enabled = true
end

--=============================================================
-- Labels
--=============================================================

local function labelFor(model)
    local e = labels[model]
    if not e then
        e = { parts = {}, partsAt = 0, nameText = nil, distText = nil, lastLabel = nil, lastDist = nil, distAt = 0, shown = false }
        labels[model] = e
    end
    if not e.nameText then
        local cfg = Hub.Config.ESP
        e.nameText = newDrawing("Text", { Text = "", Size = cfg.TextSize, Font = cfg.Font, Center = true, Outline = true, OutlineColor = Color3.new(0,0,0), Visible = false })
        e.distText = newDrawing("Text", { Text = "", Size = cfg.TextSize - 1, Font = cfg.Font, Center = true, Outline = true, OutlineColor = Color3.new(0,0,0), Color = Color3.fromRGB(215,215,220), Visible = false })
    end
    return e
end

local function hideLabel(e)
    if not e.shown then return end
    e.shown = false
    if e.nameText then e.nameText.Visible = false end
    if e.distText then e.distText.Visible = false end
end

local function drawLabel(c, now, camera)
    local cfg = Hub.Config.ESP
    local e = labelFor(c.model)
    local parts = partsOf(c.model, e)
    if #parts == 0 then hideLabel(e) return end

    local mn, mx = worldBounds(parts)
    local top = Vector3.new((mn.X + mx.X) * 0.5, mx.Y, (mn.Z + mx.Z) * 0.5)
    local sp = camera:WorldToViewportPoint(top)
    if sp.Z <= 0 then hideLabel(e) return end

    if cfg.ShowLabels then
        if e.lastLabel ~= c.label then
            e.lastLabel = c.label
            e.nameText.Text = c.label
            e.nameText.Size = cfg.TextSize
        end
        e.nameText.Color = c.color
        e.nameText.Position = Vector2.new(sp.X, sp.Y - cfg.TextSize - 4)
        e.nameText.Visible = true

        if cfg.ShowDistance then
            if now - e.distAt > 0.1 then
                e.distAt = now
                local text = string.format("%d studs", math.floor(c.dist + 0.5))
                if text ~= e.lastDist then
                    e.lastDist = text
                    e.distText.Text = text
                end
            end
            e.distText.Position = Vector2.new(sp.X, sp.Y - 2)
            e.distText.Visible = true
        else
            e.distText.Visible = false
        end
        e.shown = true
    else
        hideLabel(e)
    end
end

local function pruneLabels()
    for model, e in pairs(labels) do
        if not seen[model] then
            hideLabel(e)
            if e.nameText then e.nameText:Remove() end
            if e.distText then e.distText:Remove() end
            labels[model] = nil
        end
    end
end

--=============================================================
-- ESP collection
--=============================================================

local function collectCandidates(now)
    candidatesAt = now
    candidates = {}
    seen = {}
    local cfg = Hub.Config.ESP

    local camPos = Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.Position
    if not camPos then return end

    local function push(model, kind, label)
        if seen[model] then return end
        seen[model] = true
        local cat = cfg.Categories[kind]
        if not cat or not cat.enabled then return end
        local ok, pivot = pcall(function() return model:GetPivot().Position end)
        if not ok then return end
        if math.abs(pivot.X) > 1e6 or math.abs(pivot.Z) > 1e6 then return end
        local dist = (pivot - camPos).Magnitude
        if dist > cat.maxDistance then return end
        candidates[#candidates + 1] = { model = model, kind = kind, label = label, dist = dist, color = cat.color }
    end

    if cfg.Categories.Players.enabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local char = plr.Character
                if char and char.Parent then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        push(char, "Players", playerLabel(plr))
                    end
                end
            end
        end
    end

    for _, group in ipairs(CATEGORY_FOLDERS) do
        local cat = cfg.Categories[group.category]
        if cat and cat.enabled then
            for _, folderName in ipairs(group.folders) do
                local folder = Workspace:FindFirstChild(folderName)
                if folder then
                    for _, model in ipairs(folder:GetChildren()) do
                        if model:IsA("Model") then
                            push(model, group.category, npcLabel(model))
                        end
                    end
                end
            end
        end
    end

    table.sort(candidates, function(a, b)
        local ad = a.dist * (a.kind == "Players" and cfg.PlayerBias or 1)
        local bd = b.dist * (b.kind == "Players" and cfg.PlayerBias or 1)
        if ad ~= bd then return ad < bd end
        return a.label < b.label
    end)
end

local function updateChams()
    local cfg = Hub.Config.ESP
    local cap = math.min(cfg.MaxHighlights, 31)
    local keep = {}
    for i = 1, math.min(cap, #candidates) do
        local c = candidates[i]
        local parts = partsOf(c.model, labelFor(c.model))
        if #parts > 0 then
            keep[c.model] = true
            applyCham(c.model, c.color)
        end
    end
    for model in pairs(assigned) do
        if not keep[model] then releaseCham(model) end
    end
    local count = 0
    for _ in pairs(assigned) do count = count + 1 end
    Hub.Stats.chams = count
end

local function hideAllESP()
    releaseAllChams()
    for _, e in pairs(labels) do hideLabel(e) end
    Hub.Stats.chams = 0
    Hub.Stats.targets = 0
end

--=============================================================
-- Kill Aura
--=============================================================

local function biteCooldownFor(char)
    local fallback = 0.7
    if not Species or not char then return fallback end
    local species = char:GetAttribute("Species") or "Wolf"
    local growth = char:GetAttribute("Growth") or 1
    local ok, cd = pcall(Species.biteCooldown, species, growth)
    if ok and type(cd) == "number" then return cd end
    return fallback
end

local function tryBite(targetModel)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local trp = targetModel and targetModel:FindFirstChild("HumanoidRootPart")
    local thum = targetModel and targetModel:FindFirstChildOfClass("Humanoid")
    if not (char and hrp and hum and hum.Health > 0 and trp and thum and thum.Health > 0) then return false end
    if not WolfActions then return false end
    if targetModel:GetAttribute("FeralDead") then return false end

    -- face target on the horizontal plane
    local from, to = hrp.Position, trp.Position
    local flat = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
    if flat.Magnitude > 0.01 then
        hrp.CFrame = CFrame.lookAt(from, from + flat.Unit)
    end

    local t = Workspace:GetServerTimeNow()
    char:SetAttribute("WolfBiteAt", t)
    WolfActions:FireServer("Bite", t)
    task.delay(0.27, function()
        if targetModel and targetModel.Parent and not targetModel:GetAttribute("FeralDead") then
            local h = targetModel:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                WolfActions:FireServer("BiteHit", { t = t, m = targetModel })
            end
        end
    end)

    Hub.Stats.auraHits = Hub.Stats.auraHits + 1
    return true
end

local function auraStep()
    local cfg = Hub.Config.Aura
    if not cfg.Enabled then return end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (char and hrp and hum and hum.Health > 0) then return end

    local cd = biteCooldownFor(char)
    if os.clock() - lastBite < cd then return end

    local range = cfg.Range or 18
    local myPack = LocalPlayer:GetAttribute("FeralPack")
    local best, bestDist = nil, nil

    local function consider(model)
        if not model or not model.Parent then return end
        local h = model:FindFirstChildOfClass("Humanoid")
        local r = model:FindFirstChild("HumanoidRootPart")
        if not h or h.Health <= 0 or not r then return end
        if model:GetAttribute("FeralDead") then return end
        local pack = model:GetAttribute("FeralPack")
        if myPack ~= nil and pack ~= nil and pack == myPack then return end
        local d = (r.Position - hrp.Position).Magnitude
        if d <= range and (not bestDist or d < bestDist) then
            best, bestDist = model, d
        end
    end

    if cfg.TargetNPCs then
        for _, folderName in ipairs({"FeralNPCs", "FeralMice", "FeralCrows", "FeralCritters"}) do
            local folder = Workspace:FindFirstChild(folderName)
            if folder then
                for _, m in ipairs(folder:GetChildren()) do consider(m) end
            end
        end
    end

    if cfg.TargetPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                consider(plr.Character)
            end
        end
    end

    if best then
        lastBite = os.clock()
        tryBite(best)
    end
end

--=============================================================
