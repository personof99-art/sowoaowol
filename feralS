--=============================================================
-- Main loop / lifecycle
--=============================================================

local function step(now)
    local camera = Workspace.CurrentCamera
    if not camera then return end

    if Hub.Config.ESP.Enabled then
        if now - candidatesAt > 0.4 then
            collectCandidates(now)
            updateChams()
            pruneLabels()
            Hub.Stats.targets = #candidates
        end
        for _, c in ipairs(candidates) do
            drawLabel(c, now, camera)
        end
    else
        if Hub.Stats.chams ~= 0 or Hub.Stats.targets ~= 0 then hideAllESP() end
    end
end

function Hub:Destroy()
    running = false
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    connections = {}
    hideAllESP()
    for model, e in pairs(labels) do
        if e.nameText then e.nameText:Remove() end
        if e.distText then e.distText:Remove() end
        labels[model] = nil
    end
    for _, h in ipairs(chamPool) do pcall(function() h:Destroy() end) end
    chamPool = {}
    if gui then gui:Destroy() gui = nil end
end

if running then Hub:Destroy() end
pcall(function() if _G.FeralHub and _G.FeralHub.Destroy then _G.FeralHub:Destroy() end end)
pcall(function() if _G.FeralESP and _G.FeralESP.Destroy then _G.FeralESP:Destroy() end end)

running = true
buildGui()

local accumulator = 0
connections[#connections + 1] = RunService.RenderStepped:Connect(function(dt)
    accumulator = accumulator + dt
    if accumulator < 1 / 60 then return end
    accumulator = 0
    local ok, err = pcall(step, os.clock())
    if not ok then warn("[FeralHub] " .. tostring(err)) end
end)

connections[#connections + 1] = RunService.Heartbeat:Connect(function(dt)
    auraAccum = auraAccum + dt
    if auraAccum < 0.05 then return end
    auraAccum = 0
    local ok, err = pcall(auraStep)
    if not ok then warn("[FeralHub] aura " .. tostring(err)) end
end)

connections[#connections + 1] = UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightControl then
        if gui then gui.Enabled = not gui.Enabled end
    end
end)

_G.FeralHub = Hub
_G.FeralESP = Hub -- compat

print("[FeralHub] loaded | menu: RightCtrl | ESP on, Kill Aura off")

return Hub
