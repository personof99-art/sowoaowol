local function protect(ui)
    local parent = nil
    pcall(function()
        if gethui then parent = gethui() end
    end)
    if not parent then
        local ok, cg = pcall(function() return game:GetService("CoreGui") end)
        if ok then parent = cg end
    end
    if not parent then parent = LocalPlayer:WaitForChild("PlayerGui") end
    ui.Parent = parent
    pcall(function()
        if syn and syn.protect_gui then syn.protect_gui(ui) end
    end)
end

local function make(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    for _, c in ipairs(children or {}) do c.Parent = inst end
    return inst
end

local function styleToggle(button, on)
    if on then
        button.BackgroundColor3 = Color3.fromRGB(255, 150, 40)
        button.Text = "ON"
        button.TextColor3 = Color3.fromRGB(20, 20, 22)
    else
        button.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
        button.Text = "OFF"
        button.TextColor3 = Color3.fromRGB(200, 200, 205)
    end
end

